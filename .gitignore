# ---- Python / tooling caches
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# ---- Large or third-party material kept OUT of git (listed with SHA-256 in ARTIFACTS_MANIFEST.tsv)
# Toolchains (download sources in tools/README.md)
/tools/*
!/tools/README.md
# Raw public datasets (sources in data/README.md); loaders and checksum files stay tracked
/data/**/*.zip
/data/**/*.gz
/data/**/*.parquet
/data/**/*.tsf
/data/**/*.csv
/data/**/*.xlsx
/data/**/*.pdf
/data/**/*.json
/data/external_bench04/airquality/
/data/external_bench04/bike/
/data/external_bench04/oikolab/
/data/external_bench04/tetouan/
/data/external_v052/*/
# Per-series predictions and other large result arrays (archived externally)
*.npz
# Build products of the C99 port / firmware (rebuildable; firmware images embed series data)
*.o
*.obj
*.elf
*.map
*.dll
*.lib
*.pdb
*.exp
experiments/LEBRE-V0.52-EXT-01/mcu/series_data.h
# Very large event logs of early experiments (archived externally)
experiments/DYNAMIC-LAG-LIFECYCLE-01/DYNAMIC_LAG_LIFECYCLE_01_TAP_EVENTS.csv
experiments/EXP-0008/microtest_events.csv
experiments/EXP-0009/active_probe_events.csv
experiments/PROMOTION-POLICY-01/PROMOTION_POLICY_01_EVENTS.csv
# Visual QA renders of the documents (regenerated by the PDF builders)
/scratch/pdf_qa*/
/scratch/**/*.png
!/data/external_v052/MANIFEST.csv
